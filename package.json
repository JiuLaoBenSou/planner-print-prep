{
  "name": "planner-print-prep",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "predev": "node scripts/prepare.mjs",
    "prebuild": "node scripts/prepare.mjs",
    "dev": "vite --host 127.0.0.1 --port 4176 --strictPort",
    "dev:plus": "node scripts/dev-plus.mjs --demo",
    "dev:payments": "node scripts/dev-plus.mjs",
    "test:plus": "playwright test --config playwright.plus.config.ts",
    "build": "tsc --noEmit && vite build",
    "build:pages": "node scripts/build-pages.mjs",
    "build:billing": "node scripts/build-pages.mjs --billing",
    "test:pages": "playwright test --config playwright.pages.config.ts",
    "preview": "vite preview --host 127.0.0.1 --port 4176 --strictPort",
    "test": "vitest run",
    "test:browser": "playwright test",
    "fixtures": "tsx scripts/fixtures.ts",
    "fixtures:extra": "python scripts/extra_fixtures.py",
    "verify:pdf": "python scripts/verify_pdf.py",
    "verify:site": "python scripts/check_site.py",
    "cf:payments": "node scripts/cf-payments.mjs",
    "typecheck:payments": "tsc --project payments/tsconfig.json",
    "build:payments": "node scripts/cf-payments.mjs build",
    "test:payments:runtime": "node tests/payments/runtime.mjs"
  },
  "dependencies": {
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/vite-plugin": "2.0.0-beta.v.10",
    "@cloudflare/workers-types": "5.20261103.1",
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/libre-baskerville": "5.3.0",
    "@pdf-lib/fontkit": "1.1.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "cf": "1.0.0-beta.15",
    "esbuild": "0.28.2",
    "miniflare": "4.20260730.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "workerd": "1.20261102.1"
  },
  "workspaces": [
    "payments"
  ]
}
